# Notion reading list
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the "Book List" database with that integration.
NOTION_TOKEN=secret_your_notion_integration_token

# The database ID from the Notion database URL. The function resolves the
# database's data source automatically.
NOTION_DB_ID=your_database_id

# Optional: query a data source directly. Use this when the database has more
# than one data source and you want a specific shelf.
# NOTION_DATA_SOURCE_ID=your_data_source_id
